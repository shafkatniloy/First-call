# ==============================================================================
# VESPER RITUAL / FIRST-CALL: ENVIRONMENT VARIABLES
# ==============================================================================
# The application runs locally out of the box with zero required credentials.
# For a live multi-user leaderboard deployed across the web on Vercel,
# connect a free Supabase project (https://supabase.com).

# Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Publishable / Anon Key (either format works):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# or legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Supabase Service Role / Secret Key
SUPABASE_SERVICE_ROLE_KEY=
